# Application
APP_NAME=FactLens
APP_ENV=development
DEBUG=true

# Database and storage (required from Phase 02 onward)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# AI providers (required only when their respective phases begin)
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=

# Local embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Observability
LOGFIRE_TOKEN=

# Processing defaults
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K_CANDIDATES=10

# Browser-safe frontend configuration only
VITE_API_BASE_URL=http://localhost:8000
