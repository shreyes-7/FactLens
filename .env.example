# Application
APP_NAME=FactLens
APP_ENV=development
DEBUG=true

# Database and storage
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# AI providers
# LLM (Primary provider: Google Gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_ENABLED=true

# Groq fallback provider (Llama 3.3 / GPT-OSS)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
FACT_EXTRACTION_BATCH_SIZE=4

# Embeddings (Jina AI v3: 1024-dimensional vectors)
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSION=1024
JINA_API_KEY=

# Observability (Optional Pydantic Logfire token)
LOGFIRE_TOKEN=

# Processing defaults
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K_CANDIDATES=10

# Browser-safe frontend configuration only
VITE_API_BASE_URL=http://localhost:8000
