# Application
APP_NAME=FactLens
APP_ENV=development
DEBUG=true

# Database and storage (required from Phase 02 onward)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# AI providers (required only when their respective phases begin)
# LLM (Groq is the primary/default LLM provider; Gemini is optional)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Gemini configuration (used only if LLM_PROVIDER=gemini)
LLM_API_KEY=
LLM_MODEL=

# Embeddings (Jina AI is the primary/default embedding provider; local BGE is optional)
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSION=1024
JINA_API_KEY=

# Observability
LOGFIRE_TOKEN=

# Processing defaults
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K_CANDIDATES=10

# Browser-safe frontend configuration only
VITE_API_BASE_URL=http://localhost:8000
